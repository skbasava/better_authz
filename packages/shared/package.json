{
  "name": "@gateway/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts.ts"
    },
    "./catalog": {
      "types": "./src/catalog.ts"
    },
    "./route-config": {
      "types": "./src/route-config.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run --typecheck",
    "build": "npm run typecheck && node ./scripts/assert-types-only.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "^4.1.0"
  }
}
